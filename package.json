{
  "name": "tokoroten-audio-processor",
  "version": "1.0.0",
  "description": "Audio processing and folder management tool",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "clean": "rm -rf build dist resources/api",
    "prepare:dirs": "mkdir -p resources",
    "build:python": "pyinstaller api.spec",
    "copy:python": "cp -r dist/api resources/",
    "build:electron": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64",
    "build:mac": "npm run clean && npm run prepare:dirs && npm run build:python && npm run copy:python && npm run build:electron",
    "build": "npm run build:mac"
  },
  "author": "Atsushi Kimura",
  "license": "MIT",
  "build": {
    "appId": "com.glasswerks.tokoroten-audio-processor",
    "productName": "Tokoroten Audio Processor",
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ]
    },
    "extraResources": [
      {
        "from": "resources/api",
        "to": "api"
      }
    ],
    "files": [
      "src/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^31.2.1",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  }
}