{
  "name": "tokoroten-audio-processor",
  "version": "1.0.0",
  "description": "Audio processing and folder management tool",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "clean": "rm -rf build dist resources/api",
    "prepare:dirs": "mkdir -p resources",
    "build:python:mac": "pyinstaller api.mac.spec",
    "build:python:win": "pyinstaller api.win.spec",
    "copy:python": "cp -r dist/api resources/",
    "build:electron:arm64": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64",
    "build:electron:x64": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --x64",
    "build:electron:win": "electron-builder --win --x64",
    "build:mac:arm64": "npm run clean && npm run prepare:dirs && npm run build:python:mac && npm run copy:python && npm run build:electron:arm64",
    "build:mac:x64": "npm run clean && npm run prepare:dirs && npm run build:python:mac && npm run copy:python && npm run build:electron:x64",
    "build:win": "npm run clean && npm run prepare:dirs && npm run build:python:win && npm run copy:python && npm run build:electron:win",
    "build": "npm run build:mac:arm64"
  },
  "author": "Atsushi Kimura",
  "license": "MIT",
  "build": {
    "appId": "com.glasswerks.tokoroten-audio-processor",
    "productName": "Tokoroten Audio Processor",
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "extraResources": [
      {
        "from": "resources/api",
        "to": "api"
      }
    ],
    "files": [
      "src/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^31.2.1",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  }
}